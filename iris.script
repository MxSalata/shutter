// Runs once, during the image build (Dockerfile): the namespace, the package manager and the module.
zn "USER"
do $SYSTEM.OBJ.Load("/home/irisowner/dev/Installer.cls", "ck")
set vars("NAMESPACE") = "INTERLOCK"
do ##class(Interlock.Installer).setup(.vars)
zn "%SYS"
do ##class(Security.Users).UnExpireUserPasswords("*")
zn "INTERLOCK"
// InterSystems Package Manager, when the base image doesn't ship it
set r = ##class(%Net.HttpRequest).%New(), r.Server = "pm.community.intersystems.com", r.SSLConfiguration = "ISC.FeatureTracker.SSL.Config" do r.Get("/packages/zpm/latest/installer"), $SYSTEM.OBJ.LoadStream(r.HttpResponse.Data, "c")
// The core module: the production, the store, the gate, the ward system, the web app and the recorded runs
zpm "load /home/irisowner/dev -v":1:1
// The aihub module (live agents), only where the AI Hub package is present
if ##class(%Dictionary.CompiledClass).%ExistsId("%AI.Agent") { zpm "load /home/irisowner/dev/aihub -v":1:1 }
halt
