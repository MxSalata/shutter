# Copy to .env (ignored by git) and fill in what you change.
# Base image for the build: the contest build, or any IRIS for Health Community 2026.2+ for the replay edition.
SHUTTER_IMAGE=irishealth-community:2026.3.0AI.154.0
SHUTTER_WEB_PORT=52773
SHUTTER_SUPERSERVER_PORT=1972
# 1 on the contest image (the aihub module, live agents); 0 on a plain IRIS for Health Community base.
SHUTTER_WITH_AIHUB=1
# Leave empty to replay recorded agent runs; set for live agents.
ANTHROPIC_API_KEY=
# live, record or replay; empty keeps a mode set on the instance (SELECT Shutter.Setup_RecordAgentMode('record')), else the instance decides (live when a key is set, else replay).
# SHUTTER_DEMO_PASSWORD (default shutter) is read by the installer when it runs (the demo users and the downstream client), not by the running container.
SHUTTER_AGENT_MODE=
# The model for live agents.
SHUTTER_MODEL=claude-opus-5-5
# Days of messages, logs and traces the "Shutter message purge" task keeps (default 90). Read by the installer when it runs, as SHUTTER_DEMO_PASSWORD is, not by the running container.
SHUTTER_MESSAGE_DAYS=90
# 1 makes the message purge task, 0 does not; empty: a demo instance purges, a non-demo one does not. Read by the installer when it runs, not by the running container.
SHUTTER_MESSAGE_PURGE=
