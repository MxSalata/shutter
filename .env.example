# Copy to .env (ignored by git) and fill in what you change.
# Base image for the build: an AI Hub build (2027.1.0AI.109.0, or the contest's first, 2026.3.0AI.154.0), or any IRIS for
# Health Community 2026.2+ for the replay edition.
SHUTTER_IMAGE=irishealth-community:2027.1.0AI.109.0
SHUTTER_WEB_PORT=52773
SHUTTER_SUPERSERVER_PORT=1972
# auto: the build loads the aihub module (live agents) when the image has AI Hub and skips it on a plain IRIS for Health
# Community base (the replay edition); 1 requires AI Hub and fails the build without it; 0 skips it.
SHUTTER_WITH_AIHUB=auto
# Leave empty to replay recorded agent runs; set for live agents.
ANTHROPIC_API_KEY=
# live, record or replay; empty keeps a mode set on the instance (SELECT Shutter.Setup_RecordAgentMode('record')), else the instance decides (live when a key is set, else replay).
SHUTTER_AGENT_MODE=
# The model for live agents.
SHUTTER_MODEL=claude-opus-5-5
# Days of messages, logs and traces the "Shutter message purge" task keeps (default 90). Read by the installer when it runs, as SHUTTER_DEMO_PASSWORD is, not by the running container.
SHUTTER_MESSAGE_DAYS=90
# The demo users' and the downstream client's password (default shutter). Read by the installer when it runs, not by the running container.
# SHUTTER_DEMO_PASSWORD=
# The settings below, down to SHUTTER_LIVE_SCENARIOS, are applied each time Shutter's production starts (so `docker compose up` with them in .env is
# enough, and a change takes effect on the next start); the installer reads them too. Empty leaves the instance as it is.
# The public demo's logins (a live hospital behind an access gate): set them and the users demo (role Shutter_Demo) and
# demo-trace (role Shutter_Trace, the Management Portal's Visual Trace, read only) exist; unset, they do not.
# SHUTTER_PUBLIC_DEMO_PASSWORD=
# SHUTTER_TRACE_PASSWORD=
# 1 makes the Management Portal read only for a public demo at every start of the production (Shutter.Setup.HardenPortal:
# the portal applications lose their MatchRoles and require Shutter_Portal, which demo-trace's role alone holds), since that
# hardening lives outside the kept data and a recreated container would come back with the portal open. Leave it unset on
# a local install: an approver following the "In IRIS" links relies on the portal as IRIS made it.
# SHUTTER_DEMO_PORTAL=
# 1 turns on the live hospital: the demo hospital plays one of Shutter's scenarios every 7 minutes with fresh patients at
# present times and real faults, and sends an ordinary message a minute between stories.
# SHUTTER_LIVE=
# A cap in US dollars on the agents' live spend per UTC day (empty or 0: none); at the cap runs are refused with
# budget_exhausted and the board falls back to the rules path.
# SHUTTER_DAILY_BUDGET_USD=
# The judges: set SHUTTER_JUDGE_PASSWORD and the user judge exists (the public demo's role plus the live agents: live
# questions and convening the board); SHUTTER_JUDGE_BUDGET_USD caps one user's live spend per UTC day (empty or 0: none).
# SHUTTER_JUDGE_PASSWORD=
# SHUTTER_JUDGE_BUDGET_USD=
# The budget the public demo's banner shows (what its owner spends on live runs), a figure and its period, day or hour;
# it may be enforced outside Shutter while SHUTTER_DAILY_BUDGET_USD guards a burst. Unset, the banner shows the cap.
# SHUTTER_DEMO_BUDGET_USD=
# SHUTTER_DEMO_BUDGET_PERIOD=
# The live hospital's rotation, scenario ids in order (default S2,S8,S1,S23a,S3,S24,S15; S11 is left to the storm and to a
# run on demand). "default" or unset keeps the player's own setting.
# SHUTTER_LIVE_SCENARIOS=
# 1 makes the message purge task, 0 does not; empty: a demo instance purges, a non-demo one does not. Read by the installer when it runs, not by the running container.
SHUTTER_MESSAGE_PURGE=
# Days after a case closes before its escalation emails' text (hospital number, NHS number, date of birth) and .eml files are removed by the "Shutter retention" task; the rows keep their digest and recipients. Empty: the message days (90); 0 keeps them. Read by the installer when it runs, not by the running container.
SHUTTER_ESCALATION_DAYS=
