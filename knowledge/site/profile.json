{
  "version": 6,
  "receivers": [
    {
      "name": "Downstream Out",
      "system": "the demo bed-management system",
      "category": "current_state",
      "tier": 2,
      "applies": "arrival_order",
      "resend_timestamp": "original",
      "cancels": false,
      "merges": false,
      "api": {
        "base": "/downstream/api",
        "state": "/encounters/{encounter}",
        "receipt": "/receipts/{key}",
        "capabilities": "/capabilities",
        "operations": "/operations"
      },
      "features": {
        "conditional_writes": true,
        "receipts": true,
        "history": true,
        "dry_run": true
      }
    },
    {
      "name": "Records Out",
      "system": "the demo patient records system",
      "category": "history_of_record",
      "tier": 2,
      "applies": "arrival_order",
      "resend_timestamp": "original",
      "cancels": false,
      "merges": false,
      "api": {
        "base": "/records/api",
        "state": "/encounters/{encounter}",
        "receipt": "/receipts/{key}",
        "capabilities": "/capabilities",
        "operations": "/operations"
      },
      "features": {
        "conditional_writes": true,
        "receipts": true,
        "history": true,
        "dry_run": true
      },
      "demo": {
        "namespace": "RECORDS"
      }
    }
  ],
  "authoritative_source": "",
  "unconditional_resend": "forbidden",
  "merges": "forbidden",
  "policy": {
    "1": {
      "single": "approval",
      "ordered": "approval",
      "interleaved": "board"
    },
    "2": {
      "single": "approval",
      "ordered": "approval",
      "interleaved": "board"
    },
    "3": {
      "single": "approval",
      "ordered": "approval",
      "interleaved": "board"
    }
  },
  "approvers": {
    "role": "Shutter Approvers",
    "escalation": "the integration team's on-call",
    "close_needs_approver": false
  },
  "incident": {
    "threshold": 5,
    "window_minutes": 10,
    "quiet_seconds": 60
  },
  "model_content": {
    "free_text": false
  },
  "feed": {
    "time_zone": "Europe/London"
  },
  "mail": {
    "allowed_domains": [
      "example.nhs.uk"
    ]
  },
  "teams": [
    {
      "id": "integration",
      "name": "Integration team",
      "mailbox": "integration@example.nhs.uk",
      "receivers": [
        "Downstream Out"
      ]
    },
    {
      "id": "pas",
      "name": "PAS team",
      "mailbox": "pas@example.nhs.uk",
      "sources": [
        "PAS"
      ]
    }
  ]
}
