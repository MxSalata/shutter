{
  "version": 1,
  "receivers": [
    {
      "name": "Downstream Out",
      "system": "the demo bed-management system",
      "tier": 2,
      "applies": "arrival_order",
      "resend_timestamp": "original",
      "cancels": false,
      "api": {
        "base": "/downstream/api",
        "state": "/encounters/{encounter}",
        "receipt": "/receipts/{key}",
        "capabilities": "/capabilities",
        "operations": "/operations"
      },
      "features": {
        "conditional_writes": true,
        "receipts": true,
        "history": true,
        "dry_run": true
      }
    }
  ],
  "history_policy": "current",
  "authoritative_source": "",
  "unconditional_resend": "forbidden",
  "policy": {
    "1": {
      "single": "automatic",
      "ordered": "automatic",
      "interleaved": "board"
    },
    "2": {
      "single": "automatic",
      "ordered": "approval",
      "interleaved": "board"
    },
    "3": {
      "single": "approval",
      "ordered": "per_chain",
      "interleaved": "board"
    }
  },
  "approvers": {
    "role": "Shutter Approvers",
    "escalation": "the integration team's on-call"
  },
  "incident": {
    "threshold": 5,
    "window_minutes": 10,
    "quiet_seconds": 60
  },
  "model_content": {
    "free_text": false
  },
  "feed": {
    "time_zone": "Europe/London"
  }
}
