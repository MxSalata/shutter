<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="iris-shutter.ZPM">
    <Module>
      <Name>iris-shutter</Name>
      <Version>0.1.0</Version>
      <Description>Shutter: supervised recovery for InterSystems IRIS Interoperability. A failed message is a case, not a retry: a board of AI Hub agents investigates it, a deterministic gate and a person decide, IRIS carries out the exact approved action and verifies it. This core module runs on any IRIS or IRIS for Health Community 2026.2 or later and replays recorded agent runs; the companion module iris-shutter-aihub adds live agents on an AI Hub build.</Description>
      <Keywords>interoperability,hl7,recovery,ai agents,ai hub,workflow,contest</Keywords>
      <Author>
        <Person>MxSalata</Person>
        <CopyrightDate>2026</CopyrightDate>
        <License>MIT</License>
      </Author>
      <Packaging>module</Packaging>
      <SourcesRoot>src</SourcesRoot>
      <SystemRequirements Version=">=2026.2" Interoperability="enabled"/>
      <!-- demo = 1 installs the demo: the demo users, the demo receiver's web application and client, the recorded
           runs, the feed and scenario items enabled, the message purge task. A site install passes 0:
           zpm "load <dir> -Ddemo=0" (the IPM parameter overrides this default). -->
      <Default Name="demo" Value="1"/>
      <!-- Empty: Shutter.Production in this namespace (shape A). A production's name: Shutter's items go into that production (shape B). -->
      <Default Name="production" Value=""/>
      <!-- The core's classes, listed so that the aihub module can add its own under the same package
           (Shutter.Agent, Shutter.Tools, Shutter.Schema, Shutter.Knowledge, Shutter.Bridge.Policy,
           Shutter.Bridge.Monitor, Shutter.Bridge.Runner.AIHub) without the two modules claiming one resource. -->
      <Resource Name="Shutter.API.PKG"/>
      <Resource Name="Shutter.Bridge.Msg.PKG"/>
      <Resource Name="Shutter.Bridge.Operation.PKG"/>
      <Resource Name="Shutter.Bridge.Record.CLS"/>
      <Resource Name="Shutter.Bridge.RunSpec.CLS"/>
      <Resource Name="Shutter.Bridge.Runner.Replay.CLS"/>
      <Resource Name="Shutter.Bridge.Runner.CLS"/>
      <Resource Name="Shutter.Bridge.ToolCall.CLS"/>
      <Resource Name="Shutter.Catalogue.PKG"/>
      <Resource Name="Shutter.Index.PKG"/>
      <Resource Name="Shutter.Intake.PKG"/>
      <Resource Name="Shutter.Knowledge.Text.CLS"/>
      <Resource Name="Shutter.Msg.PKG"/>
      <Resource Name="Shutter.Operation.PKG"/>
      <Resource Name="Shutter.Process.PKG"/>
      <Resource Name="Shutter.Production.CLS"/>
      <Resource Name="Shutter.Scenarios.PKG"/>
      <Resource Name="Shutter.Service.PKG"/>
      <Resource Name="Shutter.Setup.CLS"/>
      <Resource Name="Shutter.Store.PKG"/>
      <Resource Name="Shutter.Util.PKG"/>
      <!-- The downstream system (the demo bed-management system) the production delivers to. -->
      <Resource Name="Downstream.PKG"/>
      <!-- The demo hospital's production (shape A): runs in the HOSPITAL namespace through a package mapping, so a judge
           sees Shutter watching a production it does not own. Compiled here; installed there by Hospital.Setup. -->
      <Resource Name="Hospital.PKG"/>
      <!-- Folders, security, the library, prices, recorded runs, the web applications and the production.
           InstallStatus returns a %Status and the Invoke checks it, so a failed install stops the load. -->
      <Invoke Class="Shutter.Setup" Method="InstallStatus" CheckStatus="true">
        <Arg>${root}</Arg>
        <Arg>${demo}</Arg>
        <Arg>${production}</Arg>
      </Invoke>
      <!-- The web application's built files, once they exist. -->
      <FileCopy Name="www/" Target="${cspdir}shutter/" Overlay="1"/>
      <!-- No UnitTest element: the unit tests under tests/unit run in CI and by hand, not in IPM's test phase. The feed's
           tests call a development helper that stays out of the image (.dockerignore), and the downstream system's
           contract tests set its fault setting. -->
    </Module>
  </Document>
</Export>
