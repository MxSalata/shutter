  <Document name="iris-shutter.ZPM">
    <Module>
      <Name>iris-shutter</Name>
      <Version>1.4.4</Version>
      <Description>Shutter: supervised recovery for InterSystems IRIS Interoperability. A failed message is a case, not a retry: a board of AI Hub agents investigates it, a deterministic gate and a person decide, IRIS carries out the exact approved action and verifies it. This package is the whole of Shutter for an InterSystems IRIS AI Hub build (2026.3 or later, builds 154 and 109 of the early access): the production, the store, the gate, the web application, the demo and the live agents (declarative %AI.Agent classes with typed tools, policies, schemas and knowledge bases). The core alone, for a plain IRIS for Health Community 2026.2 that replays recorded agent runs, is the module in the repository's core/ folder, loaded by path.</Description>
      <Keywords>interoperability,hl7,recovery,ai agents,ai hub,workflow,contest</Keywords>
      <Author>
        <Person>MxSalata</Person>
        <CopyrightDate>2026</CopyrightDate>
        <License>MIT</License>
      </Author>
      <Packaging>module</Packaging>
      <SourcesRoot>src</SourcesRoot>
      <!-- The AI Hub build: the agents need the %AI package, which the early access builds 2026.3.0AI.154.0 and 2027.1.0AI.109.0 have and 2026.2 has not.
           The organisers asked for this line, so that the package refuses an earlier version (announcement thread, 2 Nov 2026). -->
      <SystemRequirements Version=">=2026.3" Interoperability="enabled"/>
      <!-- demo = 1 installs the demo: the demo users, the demo receiver's web application and client, the recorded
           runs, the feed and scenario items enabled, the message purge task. A site install passes 0:
           zpm "load <dir> -Ddemo=0" (the IPM parameter overrides this default). -->
      <Default Name="demo" Value="1"/>
      <!-- Empty: Shutter.Production in this namespace (shape A). A production's name: Shutter's items go into that production (shape B). -->
      <Default Name="production" Value=""/>
      <!-- The core's classes, listed one by one so that core/module.xml (the core alone, for 2026.2) can name the same
           list and leave the agents' classes below out. -->
      <Resource Name="Shutter.API.PKG"/>
      <Resource Name="Shutter.Bridge.Msg.PKG"/>
      <Resource Name="Shutter.Bridge.Operation.PKG"/>
      <Resource Name="Shutter.Bridge.Catalogue.CLS"/>
      <Resource Name="Shutter.Bridge.Record.CLS"/>
      <Resource Name="Shutter.Bridge.RunSpec.CLS"/>
      <Resource Name="Shutter.Bridge.Runner.Replay.CLS"/>
      <Resource Name="Shutter.Bridge.Runner.CLS"/>
      <Resource Name="Shutter.Bridge.ToolCall.CLS"/>
      <Resource Name="Shutter.Catalogue.PKG"/>
      <Resource Name="Shutter.FHIR.PKG"/>
      <Resource Name="Shutter.Index.PKG"/>
      <Resource Name="Shutter.Installer.CLS"/>
      <Resource Name="Shutter.Intake.PKG"/>
      <Resource Name="Shutter.Knowledge.Text.CLS"/>
      <Resource Name="Shutter.Msg.PKG"/>
      <Resource Name="Shutter.Operation.PKG"/>
      <Resource Name="Shutter.Process.PKG"/>
      <Resource Name="Shutter.Production.CLS"/>
      <Resource Name="Shutter.Review.PKG"/>
      <Resource Name="Shutter.Portal.PKG"/>
      <Resource Name="Shutter.Scenarios.PKG"/>
      <Resource Name="Shutter.Service.PKG"/>
      <Resource Name="Shutter.Setup.CLS"/>
      <Resource Name="Shutter.Store.PKG"/>
      <Resource Name="Shutter.Util.PKG"/>
      <Resource Name="Shutter.Warehouse.PKG"/>
      <!-- The live agents (AI Hub): the agent runner for the bridge, the board members (declarative %AI.Agent classes),
           their tools, the publisher's tools and gateway, the policies, the schemas and the knowledge bases. -->
      <Resource Name="Shutter.Agent.PKG"/>
      <Resource Name="Shutter.Tools.PKG"/>
      <Resource Name="Shutter.Publish.PKG"/>
      <Resource Name="Shutter.Schema.PKG"/>
      <Resource Name="Shutter.Knowledge.PKG"/>
      <Resource Name="Shutter.Bridge.Policy.PKG"/>
      <Resource Name="Shutter.Bridge.Monitor.CLS"/>
      <Resource Name="Shutter.Bridge.Runner.AIHub.CLS"/>
      <!-- The downstream system (the demo bed-management system) the production delivers to. -->
      <Resource Name="Downstream.PKG"/>
      <!-- The demo hospital's production (shape A): runs in the HOSPITAL namespace through a package mapping, so a judge
           sees Shutter watching a production it does not own. Compiled here; installed there by Hospital.Setup. -->
      <Resource Name="Hospital.PKG"/>
      <!-- A test FHIR R4 server held to the answers IRIS for Health's own FHIR server gave when measured: what the FHIR
           plan builder and verifier are tested against. No web application serves it yet, so nothing reaches it from outside. -->
      <Resource Name="FHIRFacade.PKG"/>
      <!-- The files Setup reads from the module's root (${root}), declared so that a package carries them: the
           knowledge (block reasons, the site profile, the catalogue), the fixtures (the recorded runs, and the
           scenarios' HL7 messages, read again at run time) and the web application's built files, which /shutter
           serves from ${root}www/ where they are: nothing is copied into the csp directory, which a container may
           not let IRIS write. A package installed from the registry or an archive stays in IPM's module root
           (IPM 0.10.4 and later; by default the data directory's ipm/iris-shutter/<version>/), so ${root} outlives
           the install. IPM 0.10.0 to 0.10.3 delete it when the install ends, and Setup refuses them. -->
      <Resource Name="/knowledge/"/>
      <Resource Name="/fixtures/"/>
      <Resource Name="/www/"/>
      <!-- zpm "uninstall": before the classes go, everything the install and the onboarding added goes too, with no production
           of the site's stopped (Shutter.Util.Uninstall). A failed run stops the uninstall with the classes still there. -->
      <Invoke Class="Shutter.Util.Uninstall" Method="ModuleStatus" Phase="Clean" When="Before" CheckStatus="true"/>
      <!-- Folders, security, the library, prices, recorded runs, the web applications and the production.
           InstallStatus returns a %Status and the Invoke checks it, so a failed install stops the load. -->
      <Invoke Class="Shutter.Setup" Method="InstallStatus" CheckStatus="true">
        <Arg>${root}</Arg>
        <Arg>${demo}</Arg>
        <Arg>${production}</Arg>
      </Invoke>
      <!-- The agents' install: the provider configuration (ANTHROPIC_API_KEY in the environment, else the agents replay
           recordings), the knowledge bases, the agent mode and the publisher's web application. InstallAIHubStatus
           returns a %Status and the Invoke checks it, so an install that stops at an error stops the load. -->
      <Invoke Class="Shutter.Setup" Method="InstallAIHubStatus" CheckStatus="true">
        <Arg>${root}</Arg>
      </Invoke>
      <!-- No UnitTest element: the unit tests under tests/unit run in CI and by hand, not in IPM's test phase. The feed's
           tests call a development helper that stays out of the image (.dockerignore), and the downstream system's
           contract tests set its fault setting. -->
    </Module>
